# Neon (use the POOLED connection string)
DATABASE_URL=postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Your app's public URL (no trailing slash) – used to build invite links
APP_URL=https://love.olexweb.com

# Only you know this. Needed to create a new space at /setup
HOST_SETUP_KEY=change-me-to-a-long-random-string

# Used by your olexweb admin app (server-side only!) to manage partners
ADMIN_API_KEY=change-me-to-another-long-random-string

# Web push – generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@olexweb.com

# Protects the cleanup cron route
CRON_SECRET=change-me-too

# Vercel Blob (private store "ourspace-media"). Vercel adds this automatically when deployed.
# Only needed here to test photos and voice notes on your computer.
BLOB_READ_WRITE_TOKEN=
